{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JalenBuildsHub/agent-proofchain/spec/receipt-v2.schema.json",
  "title": "Agent ProofChain receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "allowed",
    "decision",
    "reason_codes",
    "content_sha256",
    "injection_matches",
    "claimed_actor_sha256",
    "actor_family_sha256",
    "runtime_family_sha256",
    "capability_sha256",
    "action_sha256",
    "model_sha256",
    "source_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed": {
      "type": "boolean"
    },
    "decision": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "injection_matches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "claimed_actor_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "actor_family_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_family_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "capability_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "action_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowed": {
            "const": true
          }
        },
        "required": [
          "allowed"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "const": "allow"
          }
        }
      },
      "else": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
